/target
**/*.rs.bk

# Web
web/node_modules/
web/.next/
web/out/
web/coverage/
web/.env*.local

# Data / runtime
*.db
*.sqlite
*.sqlite3
*.log
/logs/

# Windows driver build artifacts (Phase L) — see driver/windows/build.ps1
driver/windows/build/
driver/windows/*.obj
driver/windows/*.sys
driver/windows/*.pdb
driver/windows/*.exp
driver/windows/*.lib
driver/windows/*.cat
driver/windows/*.pfx

# Linux driver build artifacts (Phase M) — normally built outside the repo
# (see driver/linux/README.md), but ignore in case someone builds in-place.
driver/linux/*.ko
driver/linux/*.o
driver/linux/*.mod
driver/linux/*.mod.c
driver/linux/.*.cmd
driver/linux/Module.symvers
driver/linux/modules.order
driver/linux/.tmp_versions/

# .NET desktop app (Phase N)
desktop/**/bin/
desktop/**/obj/

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/
.github/
